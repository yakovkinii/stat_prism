    affiliation: "Kyiv Institute of Modern Psychology and Psychotherapy, Kyiv, Ukraine"
  - family-names: Petrova
    given-names: N. V.
    orcid: "https://orcid.org/0000-0002-7757-2627"
    affiliation: "Institute of Physics of the National Academy of Sciences of Ukraine, Kyiv, Ukraine"
  - family-names: Yakovkin
    given-names: I. I.
    orcid: "https://orcid.org/0000-0003-1563-8528"
    affiliation: "Institute of Physics of the National Academy of Sciences of Ukraine, Kyiv, Ukraine"
version: 1.3.8
date-released: 2026-11-25
license: GPL-3.0-or-later
repository-code: "https://github.com/yakovkinii/stat_prism"
url: "https://www.yakovkinii.com/stat_prism/"
keywords:
  - statistics
  - survey analysis
  - questionnaire
  - psychometrics
  - APA
  - data visualization
