#: ../../data-processing/impute.md:1
msgid "Impute Missing"
msgstr "Заповнення пропусків"

#: ../../data-processing/impute.md:3
msgid ""
"Fills missing cells in the selected columns, or removes rows that have "
"missing values."
msgstr ""
"Заповнює пропущені клітинки у вибраних колонках або видаляє рядки, що мають "
"пропущені значення."

#: ../../data-processing/impute.md:5
msgid "**Mean** / **Median**: from the column's non-missing numeric values."
msgstr "**Mean** / **Median**: з непропущених числових значень колонки."

#: ../../data-processing/impute.md:6
msgid "**Mode**: the most frequent value."
msgstr "**Mode**: найчастіше значення."

#: ../../data-processing/impute.md:7
msgid "**Constant value**: a value you supply."
msgstr "**Constant value**: значення, яке ви задаєте."

#: ../../data-processing/impute.md:8
msgid "**Remove rows**: drops rows missing any selected column."
msgstr "**Remove rows**: видаляє рядки з пропуском у будь-якій вибраній колонці."

#: ../../data-processing/impute.md:10
msgid "\"Missing\" captures both blank strings and true `NaN`."
msgstr "\"Пропущеними\" вважаються і порожні рядки, і справжні `NaN`."

#~ msgid "**Mean** / **Median** — from the column's non-missing numeric values."
#~ msgstr ""

#~ msgid "**Mode** — the most frequent value."
#~ msgstr ""

#~ msgid "**Constant value** — a value you supply."
#~ msgstr ""

#~ msgid "**Remove rows** — drops rows missing any selected column."
#~ msgstr ""

